APP_NAME=SafeTech
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.safetech.ge
FRONTEND_URL=https://safetech.ge
FRONTEND_URLS=https://safetech.ge,https://www.safetech.ge
REVALIDATE_SECRET=
SEED_DEMO_CONTENT=false
GEO_BLOCK_ENABLED=false
GEO_ALLOWED_COUNTRIES=GE
GEO_BLOCK_UNKNOWN_COUNTRY=false

APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tbilisi
APP_FAKER_LOCALE=en_US
TRUSTED_PROXIES=127.0.0.1,::1

ADMIN_NAME="SafeTech Admin"
ADMIN_EMAIL="safetechgeorgia@gmail.com"
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=safetech
DB_USERNAME=safetech
DB_PASSWORD=change_this_strong_password
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
QUEUE_HEALTH_STALE_SECONDS=300

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=safetechgeorgia@gmail.com
MAIL_PASSWORD=
# When Gmail SMTP is used, first add and verify info@safetech.ge as a
# "Send mail as" alias in the Gmail account above. Cloudflare Email Routing
# alone receives mail; it does not authorize outbound SMTP delivery.
MAIL_FROM_ADDRESS="info@safetech.ge"
MAIL_FROM_NAME="SafeTech Georgia"
LEADS_NOTIFICATION_EMAIL="info@safetech.ge"

CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Automatically forward newly published projects to the n8n social workflow.
N8N_PROJECT_PUBLISH_ENABLED=true
N8N_PROJECT_PUBLISH_WEBHOOK_URL=https://n8n.safetech.ge/webhook/project-published
N8N_PROJECT_PUBLISH_WEBHOOK_TOKEN=
N8N_PROJECT_PUBLISH_DELAY_SECONDS=120
N8N_PROJECT_PUBLISH_CONNECT_TIMEOUT=3
N8N_PROJECT_PUBLISH_TIMEOUT=30

# SafeTech AI Assistant. Keep the API key only in the production .env.
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
