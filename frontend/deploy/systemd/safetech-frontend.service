[Unit]
Description=SafeTech Next.js frontend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/safetech/frontend
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/test -s /var/www/safetech/frontend/.next/BUILD_ID
ExecStartPre=/usr/bin/test -d /var/www/safetech/frontend/.next/static/chunks
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
